#!/usr/bin/env python3
"""
ptrace-ism: a raw-ptrace exec-policy prototype that replaces the GDB engine.

WHAT IT IS
----------
A standalone Linux x86_64 tracer driven directly by the ptrace(2) syscall. It
execs a target `command` as its own child and observes successful exec events
across the entire process tree (fork / vfork / clone, including threaded
children). It applies a policy before the newly exec'd program enters user
space; a matching process is killed before it runs its own code.

It is written to **A/B-validate** a proposed replacement for the GDB-based
engine. `PTRACE_EVENT_EXEC` has no seccomp dependency and avoids stopping at
every syscall.

WHY IT EXISTS (the problem it proves)
-------------------------------------
GDB 15.1's `catch syscall execve execveat` is implemented on Linux via seccomp
`SECCOMP_RET_TRACE`. Under a fork/exec storm (e.g. `pytest -n 16`) the kernel
loses the PTRACE_EVENT_SECCOMP dispatch: seccomp stops race with fork/exec
clone events, and both GDB non-stop and all-stop modes stall. Raw ptrace using
`PTRACE_EVENT_EXEC` does not route through seccomp and therefore does not
suffer the lost-dispatch failure. This prototype must prove that reliability
under exactly that storm.

STATUS
------
Prototype, for A/B validation before any integration.

Scope / non-goals
-----------------
* Linux x86_64 only.
* Python 3 stdlib only (ctypes, json, math, os, signal, sys,
  time, dataclasses, pathlib).
* Observes successful execs using PTRACE_EVENT_EXEC.
* OPT-IN run timeout: `PTRACE_ISM_TIMEOUT=<seconds>` arms a SIGALRM-based
  deadline that kills the traced tree and exits 124. Disabled by default:
  unset / 0 / negative / invalid -> no timeout at all, the traced command
  runs as long as it needs (transparent behavior).
 * Policy: argv deny rules loaded from a JSON config file (no built-in deny
 * rules; see _get_deny_rules()), for A/B parity with ptrace-ism's `decide()`.
* Enforcement kills a denied tracee while it is stopped at PTRACE_EVENT_EXEC.
"""

from __future__ import annotations

import ctypes
import json
import math
import os
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path

# --------------------------------------------------------------------------- #
# Constants (Linux x86_64)
# --------------------------------------------------------------------------- #
# ptrace requests (from <sys/ptrace.h>).
PTRACE_TRACEME = 0
PTRACE_CONT = 7
PTRACE_SETOPTIONS = 0x4200
PTRACE_GETEVENTMSG = 0x4201

# ptrace options.
PTRACE_O_TRACEFORK = 1
PTRACE_O_TRACEVFORK = 2
PTRACE_O_TRACECLONE = 4
PTRACE_O_TRACEEXEC = 16
PTRACE_O_TRACEEXIT = 32
PTRACE_O_EXITKILL = 1 << 20

# Everything we want to observe on every tracee (old and new).
OPTIONS = (
    PTRACE_O_TRACEFORK
    | PTRACE_O_TRACEVFORK
    | PTRACE_O_TRACECLONE
    | PTRACE_O_TRACEEXEC
    | PTRACE_O_TRACEEXIT
    | PTRACE_O_EXITKILL
)

# PTRACE_EVENT_* codes that appear in the high 16 bits of a wait status.
PTRACE_EVENT_FORK = 1
PTRACE_EVENT_VFORK = 2
PTRACE_EVENT_CLONE = 3
PTRACE_EVENT_EXEC = 4
PTRACE_EVENT_VFORK_DONE = 5
PTRACE_EVENT_EXIT = 6


# --------------------------------------------------------------------------- #
# Timeout (OPT-IN, SIGALRM)
# --------------------------------------------------------------------------- #
# Global flag: True once SIGALRM fires. Only meaningful while the OPT-IN
# timeout is active (PTRACE_ISM_TIMEOUT > 0): the blocking waitpid in
# main_loop is interrupted by the alarm (raising InterruptedError), which
# lets the timeout teardown path run instead of hanging forever on an
# event-less wait. When the timeout is disabled no alarm is ever armed, so
# this flag can never be set.
_ALRM_TIMED_OUT = False


def _parse_timeout() -> float:
    """Read the OPT-IN run timeout from PTRACE_ISM_TIMEOUT.

    The timeout is DISABLED by default. Semantics:
    * Env var unset/empty -> disabled (returns 0.0): no SIGALRM, no deadline;
      the traced command runs as long as it needs.
    * Value <= 0 (e.g. "0" or "-5") -> disabled (returns 0.0).
    * A positive finite number ("10", "2.5") -> active with that many seconds.
    * Invalid value (non-numeric, NaN, infinity) -> warn on stderr and treat
      as disabled (returns 0.0). KISS choice: a bad value never refuses to
      run, matching the tool's tolerant env handling.
    """
    raw = os.environ.get("PTRACE_ISM_TIMEOUT")
    if not raw:
        return 0.0
    invalid_msg = (
        f"[ptrace-ism] warning: ignoring invalid PTRACE_ISM_TIMEOUT "
        f"{raw!r}; timeout disabled"
    )
    try:
        timeout = float(raw)
    except ValueError:
        print(invalid_msg, file=sys.stderr, flush=True)
        return 0.0
    if timeout <= 0:
        # Explicit "0" (or a negative value) means disabled; documented.
        return 0.0
    if not math.isfinite(timeout):
        # NaN / infinity are unusable as a deadline; warn and disable.
        print(invalid_msg, file=sys.stderr, flush=True)
        return 0.0
    return timeout


def _on_alarm(signum: int, frame) -> None:
    """SIGALRM handler: mark the run hung; the main loop handles teardown.

    Installed only while the OPT-IN timeout is active (see main_loop).
    """
    global _ALRM_TIMED_OUT
    _ALRM_TIMED_OUT = True
    print(
        "[ptrace-ism] alarm: timeout signalled, tearing down",
        file=sys.stderr,
        flush=True,
    )


def _arm_timeout(timeout: float):
    """Install the timeout handler and arm a precise one-shot wall timer."""
    previous_handler = signal.signal(signal.SIGALRM, _on_alarm)
    signal.setitimer(signal.ITIMER_REAL, timeout)
    return previous_handler


def _disarm_timeout(previous_handler) -> None:
    """Cancel the wall timer and restore the caller's SIGALRM handler."""
    signal.setitimer(signal.ITIMER_REAL, 0.0)
    signal.signal(signal.SIGALRM, previous_handler)


# --------------------------------------------------------------------------- #
# ctypes plumbing
# --------------------------------------------------------------------------- #
libc = ctypes.CDLL(None, use_errno=True)

# `long ptrace(enum __ptrace_request request, long pid, void *addr, void *data)`
libc.ptrace.restype = ctypes.c_long
libc.ptrace.argtypes = [
    ctypes.c_long,
    ctypes.c_long,
    ctypes.c_void_p,
    ctypes.c_void_p,
]


# --------------------------------------------------------------------------- #
# ExecEvent + policy (ported from ptrace-ism for A/B parity)
# --------------------------------------------------------------------------- #
@dataclass(frozen=True, slots=True)
class ExecEvent:
    pid: int
    syscall: str
    path: str
    argv: tuple[str, ...]
    argv0: str
    dirfd: int | None = None
    flags: int | None = None


_deny_rules: dict[str, list[list[str]]] | None = None


def _get_deny_rules() -> dict[str, list[list[str]]]:
    """Load deny rules from the config file (cached).

    Config: JSON file, default ~/.config/ptrace-ism.json, overridable with
    the PTRACE_ISM_CONFIG env var. Schema: {"deny": {"rm": [], "git": [["push"]]}}.
    Each key is an application basename. An empty list denies every invocation;
    otherwise each nested list is an ordered subsequence which must occur after
    argv[0].

    Semantics (there are no built-in fallback deny rules):
    * Missing config file (FileNotFoundError) -> no deny rules (allow all).
    * Completely empty config file (0 bytes or whitespace-only) -> no deny
      rules (allow all); it is NOT treated as broken/invalid JSON.
    * Empty/missing "deny" mapping -> no deny rules (allow all).
    * A malformed config or deny mapping -> refuse to run: raise SystemExit
      with a message naming the config path and the problem. The tool must
      NOT silently continue with a policy unexpectedly disabled.
    """
    global _deny_rules
    if _deny_rules is not None:
        return _deny_rules
    config_path = os.environ.get("PTRACE_ISM_CONFIG") or str(
        Path.home() / ".config" / "ptrace-ism.json"
    )
    try:
        with open(config_path, "r", encoding="utf-8") as stream:
            content = stream.read()
    except FileNotFoundError:
        # No config file: open-by-default, no deny rules (allow all).
        trace.debug_log(f"no config found at {config_path}; no deny rules")
        _deny_rules = {}
        return _deny_rules
    except OSError as exc:
        # Unreadable config (e.g. PermissionError): refuse to run.
        raise SystemExit(
            f"ptrace-ism: config {config_path} is invalid: {exc}"
        )
    except ValueError as exc:
        # UnicodeDecodeError (a ValueError subclass) from stream.read(): the
        # file is not valid UTF-8 text and therefore not a usable config.
        # This preserves the old behavior where the read inside json.load()
        # raised the same exception under this handler.
        raise SystemExit(
            f"ptrace-ism: config {config_path} is invalid: {exc}"
        )

    if content.strip() == "":
        # A completely empty (0-byte or whitespace-only) config file is a
        # valid config meaning "deny nothing": allow everything. It must NOT
        # be treated as broken/invalid JSON (which would refuse to run).
        trace.debug_log(f"config {config_path} is empty; no deny rules")
        _deny_rules = {}
        return _deny_rules

    try:
        data = json.loads(content)
    except ValueError as exc:
        # json.JSONDecodeError (a ValueError subclass): invalid JSON.
        raise SystemExit(
            f"ptrace-ism: config {config_path} is invalid: {exc}"
        )

    if not isinstance(data, dict):
        # Valid JSON that is not an object (e.g. [1,2,3] or "str").
        raise SystemExit(
            f"ptrace-ism: config {config_path} is invalid: "
            f"expected a JSON object, got {type(data).__name__}"
        )

    raw_rules = data.get("deny", {})
    if not isinstance(raw_rules, dict):
        raise SystemExit(
            f"ptrace-ism: config {config_path} is invalid: "
            '"deny" must be an object'
        )

    cleaned: dict[str, list[list[str]]] = {}
    for application, patterns in raw_rules.items():
        if not isinstance(application, str) or not application:
            raise SystemExit(
                f"ptrace-ism: config {config_path} is invalid: "
                "application names must be non-empty strings"
            )
        if not isinstance(patterns, list):
            raise SystemExit(
                f"ptrace-ism: config {config_path} is invalid: "
                f"rules for {application!r} must be a list"
            )
        if not patterns:
            cleaned[application] = [[]]
            continue
        cleaned[application] = []
        for pattern in patterns:
            if (
                not isinstance(pattern, list)
                or not pattern
                or not all(isinstance(token, str) for token in pattern)
            ):
                raise SystemExit(
                    f"ptrace-ism: config {config_path} is invalid: "
                    f"each rule for {application!r} must be a non-empty "
                    "list of strings"
                )
            cleaned[application].append(pattern)

    # An empty or missing "deny" mapping is a valid config meaning "deny
    # nothing": allow everything.
    trace.debug_log(f"config deny rules loaded from {config_path}: {cleaned}")
    _deny_rules = cleaned
    return cleaned


def _contains_in_order(args: list[str], pattern: list[str]) -> bool:
    """Return whether ``pattern`` occurs in ``args`` in the same order.

    Arguments may appear between the matched tokens. This avoids tying policy
    to command-line positions while retaining enough argv structure to keep
    an inverted sequence from matching. An empty pattern matches every argv.
    """
    if not pattern:
        return True
    pattern_index = 0
    for arg in args:
        if arg == pattern[pattern_index]:
            pattern_index += 1
            if pattern_index == len(pattern):
                return True
    return False


def decide(event: ExecEvent) -> str:
    """Policy entry point: deny if argv matches an application rule.

    argv[0] is matched by basename. A configured pattern must occur, in
    order, anywhere in argv[1:], so ["push"] denies both `git push` and
    `git -C repo push origin main` without parsing Git's global options.
    """
    rules = _get_deny_rules()
    argv = list(event.argv)
    if not argv:
        return "allow"
    application = Path(argv[0]).name
    for pattern in rules.get(application, []):
        if _contains_in_order(argv[1:], pattern):
            return "deny"
    return "allow"


# --------------------------------------------------------------------------- #
# Trace output (mirrors ptrace-ism's _trace / exec line format for A/B)
# --------------------------------------------------------------------------- #
class Tracer:
    """Owns trace routing: an optional append-file; otherwise stderr under
    PTRACE_ISM_DEBUG=1, stdout only for forced lines (deny), silent by
    default."""

    def __init__(self) -> None:
        self.trace_file = os.environ.get("PTRACE_ISM_TRACE_FILE")
        self.debug = os.environ.get("PTRACE_ISM_DEBUG") == "1"

    def line(self, message: str, *, force: bool = False) -> None:
        """Emit one trace line, flushed: file, stderr (debug or forced).

        Default routing is silent so per-exec allow lines do not pollute
        program output; deny lines pass ``force=True`` to stay visible without
        contaminating the wrapped command's stdout.
        """
        if self.trace_file:
            try:
                # ptrace-ism's _trace writes `<monotonic_ns> <message>`.
                with open(self.trace_file, "a", encoding="utf-8") as stream:
                    stream.write(f"{time.monotonic_ns()} {message}\n")
                    stream.flush()
            except OSError as exc:
                self.debug_log(f"trace write failed: {exc}")
                self.trace_file = None
        elif self.debug or force:
            print(message, file=sys.stderr, flush=True)
        # else: silent -- allowed exec lines produce no output by default

    def debug_log(self, message: str) -> None:
        if self.debug:
            print(f"[ptrace-ism:debug] {message}", file=sys.stderr, flush=True)


trace = Tracer()


# --------------------------------------------------------------------------- #
# Raw ptrace helpers
# --------------------------------------------------------------------------- #
def _ptrace(request: int, pid: int, addr=None, data=None) -> int:
    """Call libc.ptrace with full ctypes marshalling; return the raw value.

    libc is loaded with ``use_errno=True``, so ctypes saves/restores errno
    around the ptrace call automatically; no manual set_errno is needed.
    """
    return libc.ptrace(
        ctypes.c_long(request),
        ctypes.c_long(pid),
        addr,
        data,
    )


def set_options(pid: int) -> None:
    """Apply OPTIONS to a tracee.

    PITFALL: options are PER-TRACEE and never inherited at fork/clone/vfork.
    Every new pid (child or thread) MUST get PTRACE_SETOPTIONS applied before it
    is resumed, otherwise its exec/fork/clone/exit events are never reported and
    the tracer hangs or silently misses children. This is THE classic bug.
    """
    _ptrace(PTRACE_SETOPTIONS, pid, None, ctypes.c_void_p(OPTIONS))


def cont_resume(pid: int, sig: int = 0) -> bool:
    """Resume a stopped tracee, optionally delivering a pending signal."""
    return _ptrace(PTRACE_CONT, pid, None, ctypes.c_void_p(sig)) == 0


def kill_tracee(pid: int) -> bool:
    """Send SIGKILL directly; used only for forced teardown on timeout.

    PTRACE_KILL is deprecated and may succeed without killing a tracee unless
    it is in a signal-delivery stop. A direct SIGKILL has no such restriction.
    """
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return False
    except OSError:
        return False
    return True


def get_event_msg(pid: int) -> int:
    msg = ctypes.c_ulong(0)
    if _ptrace(PTRACE_GETEVENTMSG, pid, None, ctypes.byref(msg)) != 0:
        return 0
    return msg.value


# --------------------------------------------------------------------------- #
# Tracee state
# --------------------------------------------------------------------------- #
class State:
    def __init__(self) -> None:
        self.traced: set[int] = set()
        # INVARIANT: `traced` NEVER contains a dead pid. An entry is added only
        # AFTER a successful resume of the child and removed on
        # WIFEXITED/WIFSIGNALED reaping (see _record_gone). Because we never add
        # a pid before its successful resume, a child that races through its
        # FULL lifecycle (exec -> event -> exit -> reaped) before the parent's
        # fork/vfork/clone event is even processed can safely be dropped here,
        # keeping the main loop able to terminate.
        self.root = 0
        self.root_exit_code: int | None = None
        self.exec_events = 0
        self.denied = 0
        # Deterministic-timeout bookkeeping (see main_loop): start_time is set
        # when the loop begins; timeout mirrors the configured loop timeout
        # (0.0 when the OPT-IN timeout is disabled). The main loop only runs
        # the non-alarm deadline checks while timeout > 0.
        self.start_time: float = 0.0
        self.timeout: float = 0.0


# --------------------------------------------------------------------------- #
# Exec event construction + formatting
# --------------------------------------------------------------------------- #
def read_exec_event(pid: int) -> ExecEvent:
    """Build an exec event after the kernel has stopped a successful exec.

    PTRACE_EVENT_EXEC happens before the new program executes user-space
    instructions. This lets the tracer stay on PTRACE_CONT and avoid a stop at
    every syscall.
    """
    try:
        raw_argv = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        raw_argv = b""
    if raw_argv.endswith(b"\0"):
        raw_argv = raw_argv[:-1]
    argv = tuple(
        token.decode("utf-8", errors="surrogateescape")
        for token in raw_argv.split(b"\0")
    ) if raw_argv else ()
    try:
        path = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        path = argv[0] if argv else ""
    if not argv:
        argv = (os.path.basename(path) or "?",)
    return ExecEvent(
        pid=pid,
        syscall="exec",
        path=path,
        argv=argv,
        argv0=argv[0],
    )


def _exec_line(event: ExecEvent, decision: str) -> str:
    """Format an exec trace line to mirror ptrace-ism's engine line."""
    argv_str = " ".join(repr(arg) for arg in event.argv)
    loc = ""
    if event.syscall == "execveat":
        loc = f" dirfd={event.dirfd!r} flags={event.flags!r}"
    reason = ""
    if decision == "deny":
        reason = " reason='denied by config rule'"
    return (
        f"[ptrace-ism] pid={event.pid} {event.syscall} "
        f"path={event.path!r} argv=[{argv_str}]"
        f"{loc} decision={decision}{reason}"
    )


# --------------------------------------------------------------------------- #
# Event dispatcher
# --------------------------------------------------------------------------- #
def dispatch(state: State, pid: int, status: int) -> None:
    """Handle one (pid, waitpid status) event and resume/record accordingly."""
    if os.WIFEXITED(status):
        _on_exited(state, pid, os.WEXITSTATUS(status))
    elif os.WIFSIGNALED(status):
        _on_signaled(state, pid, os.WTERMSIG(status))
    elif os.WIFSTOPPED(status):
        _dispatch_stopped(state, pid, os.WSTOPSIG(status), status >> 16)


def _record_gone(state: State, pid: int) -> None:
    """Common bookkeeping once a tracee won't report again."""
    state.traced.discard(pid)


def _on_exited(state: State, pid: int, code: int) -> None:
    if pid == state.root:
        state.root_exit_code = code
    # `_record_gone` uses discard, so it is safe even if `pid` was never added
    # to `state.traced` (e.g. a child that raced its whole lifecycle before the
    # parent's fork/clone event was processed). No membership assertion here.
    _record_gone(state, pid)
    trace.debug_log(f"exited pid={pid} code={code}")


def _on_signaled(state: State, pid: int, sig: int) -> None:
    if pid == state.root:
        state.root_exit_code = 128 + sig
    # Safe for pids never in `traced`: _record_gone uses discard.
    _record_gone(state, pid)
    trace.debug_log(f"killed-by-signal pid={pid} sig={sig}")


def _dispatch_stopped(state: State, pid: int, sig: int, event: int) -> None:
    # --- ptrace events (fork/vfork/clone/exec/vfork_done/exit) ---
    if event == PTRACE_EVENT_EXIT:
        _on_event_exit(state, pid)
        return
    if event in (PTRACE_EVENT_FORK, PTRACE_EVENT_VFORK, PTRACE_EVENT_CLONE):
        _on_event_clone(state, pid, event)
        return
    if event == PTRACE_EVENT_EXEC:
        _on_event_exec(state, pid)
        return
    if event == PTRACE_EVENT_VFORK_DONE:
        _on_event_vfork_done(state, pid)
        return
    if event:
        # Unknown ptrace event. Diagnostic only; do NOT blindly resume.
        # PTRACE_CONT on a not-stopped / already-resumed tracee fails with
        # ESRCH/EIO, so logging and skipping is safer than an unguarded resume.
        print(
            f"unknown ptrace event {event} for pid {pid} (not resumed)",
            file=sys.stderr,
            flush=True,
        )
        return

    # --- creation-stop of a newly auto-attached child whose parent event
    # (fork/vfork/clone) has not been processed yet. The child is stopped RIGHT
    # NOW: install PTRACE options, suppress the internal SIGSTOP (deliver sig=0
    # -- delivering it breaks the child and stalls the storm), and record it.
    if pid not in state.traced and event == 0:
        set_options(pid)
        cont_resume(pid, sig=0)
        state.traced.add(pid)
        trace.debug_log(f"creation-stop pid={pid} traced")
        return

    # --- ordinary signal-delivery stop (real signal, no event): forward it.
    cont_resume(pid, sig=sig)


def _on_event_vfork_done(state: State, pid: int) -> None:
    """PTRACE_EVENT_VFORK_DONE: the kernel parked this parent in
    wait_for_vfork_done and now reports its child exec'd or exited.

    There is no hold bookkeeping anymore: after PTRACE_EVENT_VFORK we ALWAYS
    resumed the parent (see _on_event_clone). Resuming with PTRACE_CONT makes
    the kernel park the parent in wait_for_vfork_done, and this event is the
    kernel delivering "the child is done". The very fact that we received this
    stop guarantees `pid` is stopped RIGHT NOW, so we MUST always resume it.
    """
    cont_resume(pid, sig=0)
    trace.debug_log(f"vfork-done pid={pid} resumed")


def _on_event_exit(state: State, pid: int) -> None:
    """PTRACE_EVENT_EXIT: read exit code and PTRACE_CONT so the tracee dies.

    PTRACE_CONT lets the tracee reach its zombie state; reaping then happens
    via waitpid as an ordinary WIFEXITED stop.
    """
    code = get_event_msg(pid)
    trace.debug_log(f"event-exit pid={pid} code={code}")
    cont_resume(pid, sig=0)


def _on_event_clone(state: State, pid: int, event: int) -> None:
    """fork/vfork/clone: register the new tracee, set options, resume both.

    INVARIANT: a pid is added to `state.traced` ONLY after a SUCCESSFUL resume.
    Under a fork/exec storm the new child can run its FULL lifecycle (exec ->
    event -> exit -> reaped) BEFORE the tracer processes this parent stop (both
    events sit in the wait queue; the child's own stop is dispatched first). In
    that case cont_resume(newpid) fails with ESRCH and the dead pid must NOT
    be added to `traced`, or the main loop never terminates.
    """
    newpid = get_event_msg(pid)
    if newpid <= 0:
        trace.debug_log(
            f"clone event={event} pid={pid} bad newpid; resuming"
        )
        cont_resume(pid)
        return

    if newpid not in state.traced:
        # PITFALL: ptrace options do not inherit at fork/vfork/clone; MUST set
        # them on a brand-new tracee before it is resumed, else its events are
        # never reported. Ignore errors here (the child may already be gone).
        set_options(newpid)
        if cont_resume(newpid):
            # INVARIANT: only record the child once it is provably runnable.
            state.traced.add(newpid)
            trace.debug_log(
                f"new-tracee pid={pid} event={event} newpid={newpid}"
            )
        else:
            # ESRCH: the child already ran and died before this event processed.
            # Do NOT add it to `traced` -- it will never report again.
            trace.debug_log(
                f"clone event={event} pid={pid} newpid={newpid} "
                "refused resume (already ran and died); not traced"
            )
    else:
        # The child's own stops were processed first and it is already traced;
        # the parent still must be resumed below.
        trace.debug_log(
            f"new-tracee pid={pid} event={event} newpid={newpid} "
            "already traced; parent resume only"
        )

    # ALWAYS resume the parent, for every branch (fork/vfork/clone).
    #
    # VFORK: after PTRACE_EVENT_VFORK, resuming the parent with PTRACE_CONT
    # makes the kernel park it in wait_for_vfork_done until the child execs or
    # exits, then deliver PTRACE_EVENT_VFORK_DONE (whose handler resumes it
    # again). So an arbitrarily late VFORK stop is harmless and needs NO hold
    # state -- this is what eliminates the parent-stuck-in-VFORK deadlock.
    cont_resume(pid, sig=0)


def _on_event_exec(state: State, pid: int) -> None:
    """Apply policy before a successfully exec'd program enters user space."""
    event = read_exec_event(pid)
    state.exec_events += 1
    if _apply_policy(state, pid, event):
        cont_resume(pid, sig=0)


def _apply_policy(state: State, pid: int, event: ExecEvent) -> bool:
    """Decide a post-exec event and return whether the tracee may continue."""
    decision = decide(event)
    trace.debug_log(
        f"exec pid={pid} syscall={event.syscall} path={event.path!r} "
        f"argv={event.argv!r} decision={decision}"
    )
    if decision == "deny":
        state.denied += 1
        trace.line(_exec_line(event, decision), force=True)
        kill_tracee(pid)
        trace.debug_log(f"denied pid={pid} with SIGKILL")
        return False
    # Formatting argv can be expensive for command runners that execute many
    # short-lived tools. The normal allow path is silent, so avoid repr/join
    # work unless somebody is actually consuming the trace.
    if trace.trace_file or trace.debug:
        trace.line(_exec_line(event, decision))
    return True


# --------------------------------------------------------------------------- #
# Launch
# --------------------------------------------------------------------------- #
def launch(command: str, args: list[str], state: State) -> None:
    """fork(); child TRACEME + execvp; parent waits for the initial stop."""
    state.start_time = time.monotonic()
    pid = os.fork()
    if pid == 0:
        _ptrace(PTRACE_TRACEME, 0, None, None)
        # Make the initial setup explicit instead of relying on an implicit
        # exec trap. The parent installs options before this process executes
        # the target, so root and descendants use the same PTRACE_EVENT_EXEC
        # policy path.
        os.kill(os.getpid(), signal.SIGSTOP)
        try:
            os.execvp(command, [command] + args)
        except OSError:
            os._exit(127)

    state.root = pid
    state.traced.add(pid)
    while True:
        try:
            wpid, status = os.waitpid(pid, 0)
        except InterruptedError:
            # PITFALL: blocking waitpid can be interrupted by a signal; retry.
            continue
        except ChildProcessError:
            # The child was already reaped (edge case) and cannot report again.
            # Treat as a launch failure rather than crash.
            print(
                f"launch: child {pid} was reaped before the initial stop "
                "(no child to wait on)",
                file=sys.stderr,
            )
            state.root_exit_code = 127
            state.traced.discard(pid)
            return
        if wpid == pid and os.WIFSTOPPED(status):
            set_options(pid)
            cont_resume(pid)
            return
        # The child exited or died before its initial tracing stop.
        if wpid == pid and os.WIFEXITED(status):
            code = os.WEXITSTATUS(status)
            print(
                f"launch: child exited with code {code} before initial stop",
                file=sys.stderr,
            )
            state.root_exit_code = code
            state.traced.discard(pid)
            return
        if wpid == pid and os.WIFSIGNALED(status):
            sig = os.WTERMSIG(status)
            print(
                f"launch: child killed by signal {sig} before initial stop",
                file=sys.stderr,
            )
            state.root_exit_code = 128 + sig
            state.traced.discard(pid)
            return
        # wpid < 0 (already gone) or an unexpected status: launch failure.
        if wpid < 0:
            state.root_exit_code = 127
            state.traced.discard(pid)
            return


# --------------------------------------------------------------------------- #
# Main loop
# --------------------------------------------------------------------------- #
def print_summary(state: State) -> None:
    """Print the final run summary (exec counters, elapsed, root exit code)."""
    elapsed = time.monotonic() - state.start_time
    print(
        f"[ptrace-ism] summary exec_events={state.exec_events} "
        f"denied={state.denied} elapsed={elapsed:.3f}s "
        f"root_exit={state.root_exit_code}",
        file=sys.stderr,
    )


def main_loop(state: State, timeout: float) -> bool:
    """Blocking waitpid loop. Returns True if it ended naturally (empty set).

    The timeout is OPT-IN: when ``timeout <= 0`` (PTRACE_ISM_TIMEOUT unset,
    zero, negative, or invalid) NO SIGALRM is armed and NO deadline checks
    run -- the traced command runs as long as it needs (transparent).
    When ``timeout > 0`` a one-shot SIGALRM is armed so the blocking waitpid
    below becomes interruptible when no events arrive; without it, a hang
    would block forever on waitpid and the timeout check would never run.
    """
    global _ALRM_TIMED_OUT
    _ALRM_TIMED_OUT = False
    previous_alarm_handler = None
    if timeout > 0:
        # Install a SIGALRM handler + one-shot timer so the blocking waitpid
        # below becomes interruptible when no events arrive. Without this, a
        # hang would block forever on waitpid and the timeout check would
        # never run.
        previous_alarm_handler = _arm_timeout(timeout)

    def finish(result: bool) -> bool:
        if timeout > 0:
            _disarm_timeout(previous_alarm_handler)
        return result

    state.start_time = time.monotonic()
    state.timeout = timeout

    while state.traced:
        # Deterministic timeout: check BEFORE the blocking waitpid below. The
        # one-shot SIGALRM only interrupts an in-progress waitpid; if the alarm
        # fired while an event was being dispatched, _ALRM_TIMED_OUT is set but
        # no alarm remains to wake the NEXT blocking waitpid (so it would block
        # forever). This monotonic check covers that window directly. It only
        # runs when the OPT-IN timeout is active (timeout > 0).
        if timeout > 0 and time.monotonic() - state.start_time > state.timeout:
            print(
                f"[ptrace-ism] FAIL/HANG: timeout after {timeout}s",
                file=sys.stderr,
                flush=True,
            )
            _timeout_teardown(state)
            return finish(False)
        # PITFALL: blocking waitpid can raise InterruptedError; retry unless
        # the SIGALRM flag is set (in which case we tear down on timeout).
        # When the timeout is disabled no alarm is armed, so _ALRM_TIMED_OUT
        # can never be set and this branch cannot fire.
        try:
            wpid, status = os.waitpid(-1, 0)
        except InterruptedError:
            if _ALRM_TIMED_OUT:
                print(
                    f"[ptrace-ism] FAIL/HANG: timeout after {timeout}s",
                    file=sys.stderr,
                    flush=True,
                )
                _timeout_teardown(state)
                return finish(False)
            # Other signal (not our alarm): retry the blocking wait.
            continue
        if wpid <= 0:
            # No children left but state says otherwise; trust ECHILD and stop.
            trace.debug_log("waitpid returned no child; ending")
            break

        dispatch(state, wpid, status)

        # Drain: several events can be pending (fork storms); process them all
        # non-blocking before the next blocking wait.
        while True:
            try:
                dwpid, dstatus = os.waitpid(-1, os.WNOHANG)
            except InterruptedError:
                break
            except ChildProcessError:
                break
            if dwpid <= 0:
                break
            dispatch(state, dwpid, dstatus)

        # In-wait iteration check (still useful when events keep arriving and
        # the alarm was cancelled/ignored for a path that never re-armed it).
        # Only runs when the OPT-IN timeout is active (timeout > 0).
        if timeout > 0 and time.monotonic() - state.start_time > state.timeout:
            print(
                f"[ptrace-ism] FAIL/HANG: timeout after {timeout}s",
                file=sys.stderr,
                flush=True,
            )
            _timeout_teardown(state)
            return finish(False)

    print_summary(state)
    return finish(True)


def _timeout_teardown(state: State) -> None:
    """Kill all remaining tracees, reap them, and set the hang exit status."""
    global _ALRM_TIMED_OUT
    _ALRM_TIMED_OUT = False
    trace.debug_log("timeout: killing remaining tracees")
    for pid in list(state.traced):
        try:
            kill_tracee(pid)
        except Exception as exc:
            trace.debug_log(f"kill pid={pid} failed: {exc}")
    # Reap the killed tracees. Each waitpid uses WNOHANG (non-blocking), but we
    # still bound the whole kill+reap phase by a short deadline so teardown can
    # never block indefinitely; after it, we proceed straight to the summary.
    stop_at = time.monotonic() + 2.0
    while time.monotonic() < stop_at:
        try:
            rpid, rstatus = os.waitpid(-1, os.WNOHANG)
        except (ChildProcessError, InterruptedError):
            break
        if rpid <= 0:
            break
        dispatch(state, rpid, rstatus)
    print("[ptrace-ism] teardown complete", file=sys.stderr, flush=True)
    state.root_exit_code = 124


# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #
def usage() -> None:
    print(
        f"usage: {sys.argv[0]} <command> [args...]",
        file=sys.stderr,
    )
    print(
        "env: PTRACE_ISM_TRACE_FILE=<path>  append trace lines to a file "
        "(default: none)\n"
        "     PTRACE_ISM_DEBUG=1           verbose trace and diagnostics to stderr\n"
        "     PTRACE_ISM_TIMEOUT=<seconds> OPT-IN loop timeout (disabled unless set)\n"
        "     PTRACE_ISM_CONFIG=<path>     rules JSON (default: ~/.config/ptrace-ism.json)",
        file=sys.stderr,
    )


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        usage()
        return 2

    command = argv[1]
    args = argv[2:]

    if not command:
        usage()
        return 2

    # OPT-IN run timeout: disabled (0.0) unless PTRACE_ISM_TIMEOUT is set to a
    # positive number; see _parse_timeout() for the exact semantics.
    timeout = _parse_timeout()

    state = State()

    # Fork the child and let it exec the target under ptrace.
    launch(command, args, state)

    # If launch already saw a root exit, report and finish: a policy deny gets
    # the normal summary, anything else is a launch failure.
    if state.root_exit_code is not None and not state.traced:
        if state.denied:
            print_summary(state)
        else:
            print(
                f"[ptrace-ism] failed to launch {command!r} "
                f"(root_exit={state.root_exit_code})",
                file=sys.stderr,
            )
        return state.root_exit_code

    main_loop(state, timeout)
    return state.root_exit_code if state.root_exit_code is not None else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
